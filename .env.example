# Copy to .env for local runs. On Hugging Face, add these as Space *secrets*.

# Same Supabase Session pooler connection string the backend uses
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Where the FastAPI backend runs (local: http://localhost:7860, HF: https://<user>-<space>.hf.space)
BACKEND_URL=http://localhost:7860

# Only if you set BACKEND_API_KEY on the backend
# BACKEND_API_KEY=
